          ]
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Material": "WoodPlanks",
          "Color": [
            0.6,
            0.4,
            0.2
          ],
          "Position": [
            0,
            0.5,
            0
          ],
          "Size": [
            12,
